{
  "name": "harnessscope-report",
  "private": true,
  "type": "module",
  "scripts": {
    "build:report": "esbuild src/report.ts --bundle --minify --outfile=../internal/report/assets/report.js && esbuild src/report.css --bundle --minify --outfile=../internal/report/assets/report.css",
    "build:dashboard": "esbuild dashboard/src/app.ts --bundle --minify --target=es2020 --outfile=../internal/server/assets/dashboard.js && esbuild dashboard/src/dashboard.css --bundle --minify --outfile=../internal/server/assets/dashboard.css && node -e \"require('node:fs').copyFileSync('dashboard/index.html', '../internal/server/assets/index.html')\"",
    "build": "npm run build:report && npm run build:dashboard",
    "test:visual": "playwright test",
    "test:dashboard": "playwright test --config dashboard/playwright.config.ts",
    "build:site": "node site/build.mjs",
    "test:site": "npm run build:site && playwright test --config site/playwright.config.ts",
    "capture:site": "npm run build:site && node site/capture.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "24.10.0",
    "esbuild": "0.25.11",
    "typescript": "5.9.3"
  }
}
